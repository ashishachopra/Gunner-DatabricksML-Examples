# Calculate degree (number of connections) using native PySpark
# Degree = count of incoming edges (dst) + outgoing edges (src)

# Count outgoing edges (as source)
out_degree = edge_df.groupBy(F.col("src").alias("id")).agg(F.count("*").alias("out_degree"))

# Count incoming edges (as destination)
in_degree = edge_df.groupBy(F.col("dst").alias("id")).agg(F.count("*").alias("in_degree"))

# Combine to get total degree (undirected graph)
degrees = out_degree.join(in_degree, "id", "full_outer") \
    .fillna(0, ["out_degree", "in_degree"]) \
    .withColumn("degree", F.col("out_degree") + F.col("in_degree")) \
    .select("id", "degree") \
    .orderBy(F.desc("degree"))

display(degrees)
# Find connected components using iterative joins (native PySpark)
# Simplified for serverless compute (no caching)

# Initialize: each vertex has its own ID as component
components = vertex_df.select(F.col("id").alias("vertex"), F.col("id").alias("component"))

# Create bidirectional edges for undirected graph
bidirectional_edges = edge_df.select("src", "dst").union(
    edge_df.select(F.col("dst").alias("src"), F.col("src").alias("dst"))
)

# Iteratively propagate minimum component ID through edges
for iteration in range(5):
    # Propagate component IDs through edges
    propagated = bidirectional_edges.join(
        components,
        bidirectional_edges.src == components.vertex,
        "inner"
    ).select(
        F.col("dst").alias("vertex"),
        F.col("component")
    )
    
    # Combine with existing components and take minimum
    new_components = components.union(propagated) \
        .groupBy("vertex") \
        .agg(F.min("component").alias("component"))
    
    # Simple convergence check: count distinct component values
    old_distinct = components.select("component").distinct().count()
    new_distinct = new_components.select("component").distinct().count()
    
    components = new_components
    
    if old_distinct == new_distinct:
        print(f"Converged after {iteration + 1} iterations")
        break

print(f"Final components: {components.select('component').distinct().count()}")

# Join back with vertex attributes
result = vertex_df.join(components, vertex_df.id == components.vertex, "left") \
    .drop("vertex")

display(result)
# Label Propagation for community detection (native PySpark)
# Simplified for serverless compute

# Initialize: each vertex has its own ID as label
labels = vertex_df.select(F.col("id").alias("vertex"), F.col("id").alias("label"))

# Create bidirectional edges for undirected graph
bidirectional_edges = edge_df.select("src", "dst").union(
    edge_df.select(F.col("dst").alias("src"), F.col("src").alias("dst"))
)

maxIter = 3  # Reduced iterations for performance
for iteration in range(maxIter):
    # Get labels of neighbors
    neighbor_labels = bidirectional_edges.join(
        labels,
        bidirectional_edges.dst == labels.vertex,
        "inner"
    ).select(
        F.col("src").alias("vertex"),
        F.col("label").alias("neighbor_label")
    )
    
    # Count frequency of each label for each vertex
    label_counts = neighbor_labels.groupBy("vertex", "neighbor_label") \
        .agg(F.count("*").alias("count"))
    
    # Select most frequent label (with tie-breaking by min label)
    window = Window.partitionBy("vertex").orderBy(F.desc("count"), F.asc("neighbor_label"))
    new_labels = label_counts.withColumn("rank", F.row_number().over(window)) \
        .filter(F.col("rank") == 1) \
        .select(F.col("vertex"), F.col("neighbor_label").alias("label"))
    
    # Keep vertices that had no neighbors with their original label
    new_labels = new_labels.union(
        labels.join(new_labels, "vertex", "left_anti")
    )
    
    labels = new_labels

print(f"Label propagation completed after {maxIter} iterations")
print(f"Unique labels: {labels.select('label').distinct().count()}")

# Join back with vertex attributes
result = vertex_df.join(labels, vertex_df.id == labels.vertex, "left") \
    .drop("vertex")

display(result)
